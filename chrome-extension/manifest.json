{
  "manifest_version": 3,
  "name": "Fake News Radar - Companion",
  "version": "1.0.0",
  "description": "Analyze credibility, bias, and clickbait probability of highlighted text on any webpage instantly.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  }
}
